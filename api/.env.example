# --- API core ---
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/seamai_db
JWT_SECRET=change-me-min-10-chars
TOKEN_ENCRYPTION_SECRET=change-me-min-16-chars

# Cloudinary (meeting audio + voice sample)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (BullMQ: Jira/GitHub sync workers share this connection)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# When `true`, BullMQ is not loaded: Jira/GitHub sync processors are no-ops.
# Leave unset or `false` in any environment where you need background workers.
# DISABLE_QUEUES=false

# --- Meeting processing ---
# Shared secret for `POST /internal/meetings/:id/result` (ai-engine-2 or bridge posts results here).
# WORKER_SECRET=

# Required for meeting uploads: Nest forwards audio to ai-engine-2:
# POST {AI_ENGINE_BASE_URL}/api/v1/meetings/process-audio (form: meeting_id, project_id, file).
# The engine returns HTTP 202 quickly and processes in the background; results POST to /internal/meetings/:id/result.
# Max time (ms) for download + upload until 202 only (default 600000 = 10 min). Use the same WORKER_SECRET in Nest and ai-engine-2.
AI_ENGINE_BASE_URL=http://localhost:8000
# AI_ENGINE_REQUEST_TIMEOUT_MS=600000

# --- GitHub (OAuth + repository webhook) ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3000/integrations/github/callback
# GITHUB_OAUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/settings/integrations
# Webhook: POST {PUBLIC_API_URL}/integrations/github/webhook — Content type application/json.
# Set the same value in GitHub → Repo → Webhooks → Secret. Header X-Hub-Signature-256 is verified.
# GITHUB_WEBHOOK_SECRET=

# --- CORS & Chrome extension (Phase 9) ---
# Comma-separated allowed browser origins. Include chrome-extension://<id> for the MV3 extension.
# Empty + NODE_ENV not production = allow all origins (dev only).
# Dashboard URL (also merged into CORS when set)
# FRONTEND_URL=http://localhost:8080
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://app.seam.dev,chrome-extension://your-extension-id-here

# --- Auth cookies (cross-origin dashboard ↔ API) ---
# Local Vite proxy (same-origin): leave unset → SameSite=Lax.
# Render / remote dev (dashboard on another host): set true (requires HTTPS on API + dashboard).
# AUTH_COOKIE_CROSS_SITE=true

# Max meeting audio upload (MB). Default 500. Align reverse-proxy body limits.
# MEETING_UPLOAD_MAX_MB=500

# --- Background scheduling (Phase 8) ---
# BullMQ repeatable GitHub sync-all interval in ms (default 600000 = 10 min).
# GITHUB_SYNC_REPEAT_MS=600000
