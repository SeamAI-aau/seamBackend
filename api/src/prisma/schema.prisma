datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

//
// ENUMS
//

enum Role {
  SCRUM_MASTER
  DEVELOPER
}

enum MeetingStatus {
  UPLOADED
  PROCESSING
  TASKS_EXTRACTED
  FAILED
}
enum TaskStatus {
  EXTRACTED
  SENT_TO_DEVELOPER
  APPROVED
  REJECTED
  SYNCED
}

//
// MODELS
//

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(DEVELOPER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects  Project[]       @relation("OwnedProjects")
  projectMembers ProjectMember[]
  tasks          Task[]          @relation("AssignedTasks")
  refreshTokens  RefreshToken[]
}

model Project {
  id             String   @id @default(uuid())
  name           String
  description    String?
  githubRepoUrl  String?
  jiraProjectKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownerId String
  owner   User   @relation("OwnedProjects", fields: [ownerId], references: [id])

  members  ProjectMember[]
  meetings Meeting[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Meeting {
  id             String        @id @default(uuid())
  title          String
  audioUrl       String
  audioPublicId  String?       // Cloudinary public ID; used to delete audio after transcription
  status         MeetingStatus @default(UPLOADED)
  createdAt      DateTime      @default(now())

  projectId   String
  project     Project       @relation(fields: [projectId], references: [id])

  transcripts Transcript[]
  tasks       Task[]
}

model Transcript {
  id          String   @id @default(uuid())
  meetingId   String
  version     Int
  content     String
  diarization Json
  createdAt   DateTime @default(now())

  meeting     Meeting  @relation(fields: [meetingId], references: [id])

  @@unique([meetingId, version])
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(EXTRACTED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id])

  assigneeId String?
  assignee   User?   @relation("AssignedTasks", fields: [assigneeId], references: [id])

  externalId String?
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
