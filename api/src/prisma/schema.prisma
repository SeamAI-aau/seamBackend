datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

//
// ENUMS
//

enum Role {
  SCRUM_MASTER
  DEVELOPER
}

enum MeetingStatus {
  UPLOADED
  PROCESSING
  TASKS_EXTRACTED
  FAILED
}
enum TaskStatus {
  EXTRACTED
  SENT_TO_DEVELOPER
  APPROVED
  REJECTED
  SYNCED
}

//
// MODELS
//

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(DEVELOPER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects   Project[]       @relation("OwnedProjects")
  projectMembers  ProjectMember[]
  tasks           Task[]          @relation("AssignedTasks")
  meetingsCreated Meeting[]
  githubUsername     String?
  voiceSampleUrl     String?
  voiceSamplePublicId String?  // Cloudinary public ID for cleanup when replacing
  refreshTokens      RefreshToken[]
  jiraAccount     JiraAccount?
  githubAccount   GithubAccount?
  activityLogs       ActivityLog[]
  developerActivities DeveloperActivity[]
  notifications       Notification[]
}

model Project {
  id             String   @id @default(uuid())
  name           String
  description    String?
  githubRepoUrl  String?
  jiraProjectKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownerId String
  owner   User   @relation("OwnedProjects", fields: [ownerId], references: [id])

  members            ProjectMember[]
  meetings           Meeting[]
  pullRequests       PullRequest[]
  blockers           Blocker[]
  transcriptBlockers TranscriptBlocker[]
  activityLogs         ActivityLog[]
  developerActivities  DeveloperActivity[]
}

model ProjectMember {
  id        String              @id @default(uuid())
  projectId String
  email     String              // invited or member email
  status    ProjectMemberStatus  @default(ACTIVE)
  userId    String?             // null until accepted (PENDING invite)
  createdAt DateTime            @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@unique([projectId, email])
}

model Meeting {
  id             String        @id @default(uuid())
  title          String
  audioUrl       String
  audioPublicId  String?       // Cloudinary public ID; used to delete audio after transcription
  status         MeetingStatus @default(UPLOADED)
  durationSeconds Int?         // From worker or upload metadata
  participants   Json?         // Optional: [{ userId?, email?, name? }]
  createdAt      DateTime      @default(now())

  projectId   String
  project     Project       @relation(fields: [projectId], references: [id])

  /// User who created/uploaded this meeting.
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])

  transcripts        Transcript[]
  tasks              Task[]
  transcriptBlockers TranscriptBlocker[]
}

model Transcript {
  id          String   @id @default(uuid())
  meetingId   String
  version     Int
  content     String
  diarization Json
  createdAt   DateTime @default(now())

  meeting     Meeting  @relation(fields: [meetingId], references: [id])
  tasks       Task[]


  @@unique([meetingId, version])
}

model Task {
  id              String      @id @default(uuid())
  title           String
  description     String?
  status          TaskStatus  @default(EXTRACTED)
  confidenceScore Float?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  meetingId       String
  meeting         Meeting     @relation(fields: [meetingId], references: [id])

  transcriptId    String
  transcript      Transcript  @relation(fields: [transcriptId], references: [id])

  jiraIssueKey  String?

  assigneeId      String?
  assignee        User?       @relation("AssignedTasks", fields: [assigneeId], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}


model JiraAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  cloudId       String
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
}

enum ProjectMemberStatus {
  PENDING  // invited by email, not yet accepted
  ACTIVE   // added or accepted
}

enum PullRequestState {
  OPEN
  CLOSED
}

enum BlockerType {
  STALE_PR
  NO_REVIEWERS
  WAITING_REVIEW
  DRAFT_TOO_LONG
}

model GithubAccount {
  id           String    @id @default(uuid())
  userId       String    @unique
  accessToken  String
  refreshToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Cached GitHub login and avatar for profile display.
  username   String?
  avatarUrl  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PullRequest {
  id                      String            @id @default(uuid())
  githubId                Int               @unique
  title                   String
  author                  String
  state                   PullRequestState
  draft                   Boolean           @default(false)
  url                     String
  projectId               String
  reviewRequestedAt       DateTime?
  requestedReviewerLogins Json?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  prCreatedAt             DateTime
  prUpdatedAt             DateTime

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  blockers   Blocker[]
}

model Blocker {
  id            String     @id @default(uuid())
  projectId     String
  pullRequestId String
  type         BlockerType
  message      String
  createdAt    DateTime   @default(now())

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, type])
}

/// Activity log for project/user actions (task assignments, approvals, meeting uploads, etc.).
model ActivityLog {
  id         String   @id @default(uuid())
  projectId  String?
  userId     String?
  action     String   // e.g. "task.assigned", "task.approved", "meeting.uploaded"
  entityType String?  // e.g. "Task", "Meeting"
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

/// Developer activity from GitHub and Jira. Selective storage: PRs (opened/merged), daily commit counts, Jira status transitions only.
model DeveloperActivity {
  id         String   @id @default(uuid())
  projectId  String
  userId     String?
  source     String   // GITHUB | JIRA
  type       String   // commit | pr_opened | pr_merged | pr_reviewed | jira_issue_created | jira_issue_updated | jira_comment
  externalId String?
  title      String?
  metadata   Json?
  occurredAt DateTime
  createdAt  DateTime @default(now())

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([source, externalId])
  @@index([projectId])
  @@index([userId])
  @@index([occurredAt])
  @@index([projectId, occurredAt])
}

/// Blockers from meeting transcripts (NLP) or system (CI failure, task inactivity). Shown next to GitHub blockers.
model TranscriptBlocker {
  id        String   @id @default(uuid())
  meetingId String?  // null for system-generated (ci_failure, task_inactivity)
  projectId String
  category  String?  // e.g. "risk", "dependency", "ci_failure", "task_inactivity"
  message   String
  createdAt DateTime @default(now())

  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// In-app notifications for browser and VS Code dashboards. Can optionally trigger email.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String    // invitation_sent | invitation_accepted | task_approved | task_declined | task_assigned | blocker_detected | meeting_uploaded
  title     String
  body      String?   // Optional longer message
  metadata  Json?     // entityId, projectId, links, etc.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, readAt])
}