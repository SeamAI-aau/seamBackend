generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  name                String
  passwordHash        String
  role                Role                @default(DEVELOPER)
  emailVerifiedAt     DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  githubUsername      String?
  avatarUrl           String?
  avatarPublicId      String?
  voiceSampleUrl      String?
  voiceSamplePublicId String?
  activityLogs        ActivityLog[]
  authTokens          UserAuthToken[]
  developerActivities DeveloperActivity[]
  githubAccount       GithubAccount?
  jiraAccount         JiraAccount?
  meetingsCreated     Meeting[]
  notifications       Notification[]
  ownedProjects       Project[]           @relation("OwnedProjects")
  projectMembers      ProjectMember[]
  refreshTokens       RefreshToken[]
  tasks               Task[]              @relation("AssignedTasks")
  tasksCreated        Task[]              @relation("TasksCreated")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model UserAuthToken {
  id        String        @id @default(uuid())
  userId    String
  tokenHash String
  type      AuthTokenType
  expiresAt DateTime
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Project {
  id                  String              @id @default(uuid())
  name                String
  description         String?
  githubRepoUrl       String?
  jiraProjectKey           String?
  jiraLastActivitySyncAt   DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  ownerId                  String
  activityLogs        ActivityLog[]
  blockers            Blocker[]
  developerActivities DeveloperActivity[]
  meetings            Meeting[]
  owner               User                @relation("OwnedProjects", fields: [ownerId], references: [id])
  members             ProjectMember[]
  pullRequests        PullRequest[]
  transcriptBlockers  TranscriptBlocker[]
  tasks               Task[]
}

model ProjectMember {
  id        String              @id @default(uuid())
  projectId String
  userId    String?
  createdAt DateTime            @default(now())
  email     String
  status    ProjectMemberStatus @default(ACTIVE)
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@unique([projectId, email])
}

model Meeting {
  id                 String              @id @default(uuid())
  title              String
  audioUrl           String
  createdAt          DateTime            @default(now())
  projectId          String
  status             MeetingStatus       @default(UPLOADED)
  audioPublicId      String?
  /// User who created/uploaded this meeting.
  createdById        String
  durationSeconds    Int?
  participants       Json?
  /// External processor job id (e.g. ai-engine-2 `job_id` from POST /api/v1/meetings/process).
  externalJobId      String?
  /// Which engine is processing this meeting (e.g. `ai-engine-2`).
  processingEngine   String?
  processingStartedAt DateTime?
  lastProcessingError String?
  createdBy          User                @relation(fields: [createdById], references: [id])
  project            Project             @relation(fields: [projectId], references: [id])
  tasks              Task[]
  transcripts        Transcript[]
  transcriptBlockers TranscriptBlocker[]
}

model Transcript {
  id          String   @id @default(uuid())
  meetingId   String
  version     Int
  content     String
  diarization Json
  summary     Json?
  insights    Json?
  suggestedActions Json?
  createdAt   DateTime @default(now())
  tasks       Task[]
  meeting     Meeting  @relation(fields: [meetingId], references: [id])

  @@unique([meetingId, version])
}

enum JiraProposalAction {
  CREATE
  TRANSITION
}

enum TaskSource {
  MANUAL
  MEETING_EXTRACTION
}

model Task {
  id              String     @id @default(uuid())
  title           String
  description     String?
  status          TaskStatus @default(EXTRACTED)
  source          TaskSource @default(MANUAL)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  projectId       String
  createdById     String
  meetingId       String?
  assigneeId      String?
  confidenceScore Float?
  transcriptId    String?
  jiraIssueKey    String?
  /// AI / engine intent: create new Jira issue vs transition existing (applied only after dev approve).
  jiraProposalAction       JiraProposalAction?
  jiraProposalIssueKey     String?
  jiraProposalTransitionId String?
  jiraProposalTargetStatus String?
  /// Last Jira create failure message (cleared on successful SYNCED). Used for SM visibility while Bull retries.
  jiraSyncLastError String?
  assignee        User?      @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdBy       User       @relation("TasksCreated", fields: [createdById], references: [id])
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  meeting         Meeting?   @relation(fields: [meetingId], references: [id])
  transcript      Transcript? @relation(fields: [transcriptId], references: [id])

  @@index([projectId])
  @@index([meetingId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JiraAccount {
  id           String   @id @default(uuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  cloudId      String
  /// Atlassian account id (from /rest/api/3/myself) for changelog author mapping.
  accountId    String?
  displayName  String?
  emailAddress String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([accountId])
}

model GithubAccount {
  id           String   @id @default(uuid())
  userId       String   @unique
  accessToken  String
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  avatarUrl    String?
  /// Cached GitHub login and avatar for profile display.
  username     String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// GitHub `X-GitHub-Delivery` ids we have already accepted (idempotent webhook processing).
model GithubWebhookDelivery {
  id          String   @id @default(uuid())
  deliveryId String   @unique
  createdAt   DateTime @default(now())
}

model PullRequest {
  id                      String           @id @default(uuid())
  githubId                BigInt           @unique
  title                   String
  author                  String
  state                   PullRequestState
  draft                   Boolean          @default(false)
  url                     String
  projectId               String
  reviewRequestedAt       DateTime?
  requestedReviewerLogins Json?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  prCreatedAt             DateTime
  prUpdatedAt             DateTime
  blockers                Blocker[]
  project                 Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Blocker {
  id            String      @id @default(uuid())
  projectId     String
  pullRequestId String
  type          BlockerType
  message       String
  createdAt     DateTime    @default(now())
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, type])
}

/// Activity log for project/user actions (task assignments, approvals, meeting uploads, etc.).
model ActivityLog {
  id         String   @id @default(uuid())
  projectId  String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

/// Developer activity from GitHub and Jira (commits, PRs, Jira status/assignee/comments/worklog, etc.).
model DeveloperActivity {
  id         String   @id @default(uuid())
  projectId  String
  userId     String?
  source     String
  type       String
  externalId String?
  title      String?
  metadata   Json?
  occurredAt DateTime
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@unique([source, externalId])
  @@index([projectId])
  @@index([userId])
  @@index([occurredAt])
  @@index([projectId, occurredAt])
}

/// Blockers from meeting transcripts (NLP) or system (CI failure, task inactivity). Shown next to GitHub blockers.
model TranscriptBlocker {
  id        String   @id @default(uuid())
  meetingId String?
  projectId String
  category  String?
  message   String
  createdAt DateTime @default(now())
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// In-app notifications for browser and VS Code dashboards. Can optionally trigger email.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, readAt])
}

enum Role {
  SCRUM_MASTER
  DEVELOPER
}

enum MeetingStatus {
  UPLOADED
  PROCESSING
  TASKS_EXTRACTED
  FAILED
}

enum TaskStatus {
  EXTRACTED
  SENT_TO_DEVELOPER
  APPROVED
  REJECTED
  SYNCED
}

enum ProjectMemberStatus {
  PENDING
  ACTIVE
}

enum PullRequestState {
  OPEN
  CLOSED
}

enum BlockerType {
  STALE_PR
  NO_REVIEWERS
  WAITING_REVIEW
  DRAFT_TOO_LONG
}
