datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

//
// ENUMS
//

enum Role {
  SCRUM_MASTER
  DEVELOPER
}

enum MeetingStatus {
  UPLOADED
  PROCESSING
  TASKS_EXTRACTED
  FAILED
}
enum TaskStatus {
  EXTRACTED
  SENT_TO_DEVELOPER
  APPROVED
  REJECTED
  SYNCED
}

//
// MODELS
//

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(DEVELOPER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects  Project[]       @relation("OwnedProjects")
  projectMembers ProjectMember[]
  tasks          Task[]          @relation("AssignedTasks")
  refreshTokens  RefreshToken[]
  jiraAccount    JiraAccount?
  githubAccount  GithubAccount?
}

model Project {
  id             String   @id @default(uuid())
  name           String
  description    String?
  githubRepoUrl  String?
  jiraProjectKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownerId String
  owner   User   @relation("OwnedProjects", fields: [ownerId], references: [id])

  members       ProjectMember[]
  meetings      Meeting[]
  pullRequests PullRequest[]
  blockers     Blocker[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Meeting {
  id          String        @id @default(uuid())
  title       String
  audioUrl    String
  status      MeetingStatus @default(UPLOADED)
  createdAt   DateTime      @default(now())

  projectId   String
  project     Project       @relation(fields: [projectId], references: [id])

  transcripts Transcript[]
  tasks       Task[]
}

model Transcript {
  id          String   @id @default(uuid())
  meetingId   String
  version     Int
  content     String
  diarization Json
  createdAt   DateTime @default(now())

  meeting     Meeting  @relation(fields: [meetingId], references: [id])
  tasks       Task[]


  @@unique([meetingId, version])
}

model Task {
  id              String      @id @default(uuid())
  title           String
  description     String?
  status          TaskStatus  @default(EXTRACTED)
  confidenceScore Float?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  meetingId       String
  meeting         Meeting     @relation(fields: [meetingId], references: [id])

  transcriptId    String
  transcript      Transcript  @relation(fields: [transcriptId], references: [id])

  jiraIssueKey  String?

  assigneeId      String?
  assignee        User?       @relation("AssignedTasks", fields: [assigneeId], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}


model JiraAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  cloudId       String
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
}

enum PullRequestState {
  OPEN
  CLOSED
}

enum BlockerType {
  STALE_PR
  NO_REVIEWERS
  WAITING_REVIEW
  DRAFT_TOO_LONG
}

model GithubAccount {
  id           String    @id @default(uuid())
  userId       String    @unique
  accessToken  String
  refreshToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PullRequest {
  id                      String            @id @default(uuid())
  githubId                Int               @unique
  title                   String
  author                  String
  state                   PullRequestState
  draft                   Boolean           @default(false)
  url                     String
  projectId               String
  reviewRequestedAt       DateTime?
  requestedReviewerLogins Json?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  prCreatedAt             DateTime
  prUpdatedAt             DateTime

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  blockers   Blocker[]
}

model Blocker {
  id            String     @id @default(uuid())
  projectId     String
  pullRequestId String
  type         BlockerType
  message      String
  createdAt    DateTime   @default(now())

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, type])
}