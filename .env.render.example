# Production template — copy values into Render / DigitalOcean env (do not commit secrets).
# Repo root = seamBackend
#
# Deploy commands (recommended):
#   Build:  npm ci && npm run build:api
#   Migrate: npm run db:migrate:deploy   (once per deploy — see below)
#   Start:  npm run start:api
#
# DigitalOcean App Platform: do NOT run migrate in the Build command if deploys overlap
# or you also run migrate on start. Use a Job component (PRE_DEPLOY, "Before every deploy")
# with run command: npm run db:migrate:deploy — same env as the API (DATABASE_URL, etc.).
# P1002 "advisory lock" = another migrate is running or a stale Postgres session still holds
# lock 72707369 (e.g. crashed deploy, local `prisma migrate dev` against prod, two deploys at once).

NODE_ENV=production
PORT=3000

APP_NAME=Seam AI
APP_URL=https://seam-ai-web-dashboard.onrender.com
API_URL=https://seambackend.onrender.com
FRONTEND_URL=https://seam-ai-web-dashboard.onrender.com
CORS_ORIGINS=https://seam-ai-web-dashboard.onrender.com,https://seam-ai-2zkh6.ondigitalocean.app
AUTH_COOKIE_CROSS_SITE=true

# Aiven Postgres — no sslmode in URL (pg-pool applies CA from api/dist/certs/ca.pem after build)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/defaultdb
DATABASE_SSL=true
DATABASE_SSL_CA_PATH=./api/dist/certs/ca.pem

JWT_SECRET=change-me-min-10-chars
TOKEN_ENCRYPTION_SECRET=change-me-min-16-chars
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

DISABLE_QUEUES=true
REDIS_HOST=localhost
REDIS_PORT=6379

AI_ENGINE_BASE_URL=https://your-ai-engine.onrender.com
WORKER_SECRET=change-me

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://seambackend.onrender.com/integrations/github/callback
GITHUB_OAUTH_SUCCESS_REDIRECT_URL=https://seam-ai-web-dashboard.onrender.com/settings/integrations

JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=https://seambackend.onrender.com/integrations/jira/callback
JIRA_OAUTH_SUCCESS_REDIRECT_URL=https://seam-ai-web-dashboard.onrender.com/settings/integrations
